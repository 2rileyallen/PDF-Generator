        { "type": "rectangle", "x": 0, "y": 0, "w": 210, "h": 297, "r": 0, "g": 0, "b": 0, "opacity": 0.6 },
        { "type": "define_column", "name": "conclusion_col", "x": 25, "y": 130, "w": 160 },
        { "type": "use_column", "name": "conclusion_col" },
        { "type": "text", "content": "THE JOURNEY CONTINUES", "align": "C", "font_family": "RobotoLight", "font_size": 14, "r": 200, "g": 200, "b": 255 },
        { "type": "add_spacing", "h": 15 },
        { "type": "text", "content": "Our understanding of the cosmos is ever-expanding. The worlds of our solar system are just the first chapter in an infinite story written in the stars.", "align": "C", "font_family": "Roboto", "font_size": 18, "r": 255, "g": 255, "b": 255 }
